# Do NOT add them here; the container must have them for inference.

backend/instance/
!backend/instance/.gitkeep

dataset/raw/
dataset/processed/
dataset/versions/*/images/
dataset/reports/

frontend/node_modules/

dist/
build/
*.egg-info/

scripts/_diag_*.py
docs/_site/

.DS_Store
Thumbs.db
