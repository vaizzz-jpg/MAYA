# MAYA .dockerignore
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

.git/
.gitignore
.github/

.venv/
.env
.env.*
!.env.example

logs/
*.log

uploads/
!uploads/.gitkeep

reports/
!reports/.gitkeep

artifacts/investigations/
artifacts/phase3/
artifacts/phase4/
